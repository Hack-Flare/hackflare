# Example environment file. Replace all placeholder secrets and URLs.

# Application
ENVIRONMENT=development
AUTO_MIGRATE=false
JWT_SECRET=CC+GwABTHe/pCrp402AvRePRNAfHJMPHawfVTvP0M+0=
HCA_CLIENT_ID=your_hackclub_client_id
HCA_CLIENT_SECRET=your_hackclub_client_secret
HCA_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
ADMIN_EMAILS=admin@example.com
FRONTEND_URL=http://localhost:3000

# Generate a high-entropy JWT secret with: openssl rand -base64 32

# Database
DATABASE_URL=postgres://hackflare:hackflare@db:5432/hackflare
POSTGRES_USER=hackflare
POSTGRES_PASSWORD=hackflare
POSTGRES_DB=hackflare

# Authoritative DNS
DNS_NAMESERVERS=ns1.hackflare.dev.,ns2.hackflare.dev.
DNS_SOA_MNAME=ns1.hackflare.dev.
DNS_SOA_RNAME=dns.hackflare.dev.

# Optional SMTP. Leave SMTP_HOST unset to disable password reset email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@hackflare.dev
